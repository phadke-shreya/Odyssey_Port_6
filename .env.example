# Copy this file to .env and fill it in.
# .env is gitignored -- never commit it.

# Needed to WRITE answers. Search and citations work without it.
OPENAI_API_KEY=

# Leave blank to talk to api.openai.com directly.
# Set this only if you go through a company gateway / proxy,
# e.g. https://your-gateway.example.com/v1
OPENAI_BASE_URL=

# Which model writes the answers. Change this if your gateway or a local
# server (Ollama, LM Studio) uses a different name, e.g. "llama3.2".
CHAT_MODEL=gpt-4o-mini

# Which model turns text into vectors, when EMBEDDING_PROVIDER=openai.
EMBEDDING_MODEL=text-embedding-3-small

# Which service turns text into search vectors.
#   local  = runs on this machine, no key needed, ~256-token limit
#   openai = better retrieval, 8191-token limit, needs a working key
# Changing this requires: python ingest.py --reset
EMBEDDING_PROVIDER=local

# Which port the API listens on, and where the UI looks for it.
# Change both together if 8006 is taken on your machine.
API_PORT=8006
API_URL=http://127.0.0.1:8006
