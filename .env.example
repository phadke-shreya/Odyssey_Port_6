# Copy this file to .env and fill it in. .env is gitignored -- never commit it.
#
# Embedding and chat are separate jobs and may use different providers. Each has
# its own key and base URL, so configuring one cannot break the other.
# A single shared OPENAI_API_KEY / OPENAI_BASE_URL pair still works as a fallback.

# --- Embeddings --------------------------------------------------------
#   openai = a hosted model, 8191-token window, needs a working key
#   local  = ChromaDB's built-in model, no key, but only a ~256-token window
# Changing either of the next two requires: python ingest.py --reset
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
# Blank = api.openai.com. Set for a company gateway or a local server.
EMBEDDING_BASE_URL=

# --- Chat (writing the answer) -----------------------------------------
# For OpenAI:  CHAT_MODEL=gpt-4o-mini, CHAT_API_KEY=sk-..., CHAT_BASE_URL blank
# For Ollama:  CHAT_MODEL=llama3.2,    CHAT_API_KEY=ollama, CHAT_BASE_URL below
CHAT_MODEL=gpt-4o-mini
CHAT_API_KEY=
CHAT_BASE_URL=

# --- Ports -------------------------------------------------------------
API_PORT=8006
API_URL=http://127.0.0.1:8006
